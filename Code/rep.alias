<drac2>


def search_list(query: str, item_list: list[str]) -> list[str]|None:
    """
    Searches for item in list.

    Args:
        query (str): The query being made
        item_list (list): List of items

    Return:
        list[str]|None: If it finds at least one match, it returns the item(s) in a list, otherwise it returns None
    """

    # Casefold query (so that number of total case folds is n+1)
    query = query.casefold()

    # Finds at least 1 match
    item_results = [item for item in item_list if query in item.casefold()]
    return item_results or None


def multiple_match_determine(search_result: list[str], target: str) -> str|None:
    """
    Determines if there is an exact match in search results
    
    Args:
        search_result (list[str]): List of search results
        target (str): Input value to match

    Returns:
        str|None: The exact match if found, otherwise None
    """

    # Casefold target (so that number of total case folds is n+1)
    target = target.casefold()

    # For each match in search result
    for match in search_result:

        # If exact match, return match
        if match.casefold() == target:
            return match


def log_entry(ch: character, organization_name: str, delta: int, total: int, img_url: str, color: str) -> None:
    """
    Logs an entry into repLog

    Args:
        ch (character): Character object
        organization_name (str): Name of organization
        delta (int): Change in CC
    """

    # Check to see if repLog exists already
    rep_log_test = ch.get_cvar("repLog", default=None)

    # Grab time and time string
    epoch_time = floor(time())
    time_str = f"<t:{epoch_time}:d> <t:{epoch_time}:T> **Change:** {delta} **Total:** {total}"

    # If repLog exists
    if rep_log_test:
        rep_log_dict = load_json(rep_log_test)

    # If repLog does not exist
    else:
        rep_log_dict = dict()
    
    # If the organization exists in the log
    if organization_name in rep_log_dict.keys():
        if "log" in rep_log_dict[organization_name].keys():
            rep_log_dict[organization_name]["log"].append(time_str)

        else:
            rep_log_dict[organization_name]["log"] = [time_str]

        rep_log_dict[organization_name]["img_url"] = img_url
        rep_log_dict[organization_name]["color"] = color


    # If the organization does not exist in the log
    else:
        rep_log_dict[organization_name] = {"log": [time_str], "img_url": img_url, "color": color}

    # Update cvar
    ch.set_cvar("repLog", dump_json(rep_log_dict))


def update_cc(ch: character, organization_name: str, delta: int, img_url: str, color: str) -> int:
    """
    Updates/creates reputation counter

    Args:
        ch (character): Character object
        organization_name (str): Name of organization
        delta (int) Change in CC

    Return:
        (int): New value of CC
    """

    # If rep cc exists already, store cc
    if ch.cc_exists(f"Rep - {organization_name}"):
        rep_cc = ch.cc(f"Rep - {organization_name}")

    # If rep cc doesn't exist, create and store cc
    else:
        rep_cc = ch.create_cc(
            name=f"Rep - {organization_name}",
            minVal="0",
            maxVal=None,
            reset=None,
            dispType=None,
            title=f"Rep - {organization_name}",
            desc=f"Reputation with {organization_name}",
            initial_value="0"
        )

    # Modify cc by delta
    rep_cc.mod(delta)

    # If there is a change, log entry
    if delta != 0:
        log_entry(ch, organization_name, delta, rep_cc.value, img_url, color)

    # If there was not a change
    else:
        pass

    return rep_cc.value


def get_rewards(ch: character, org_name: str, org_dict: dict, delta: int, footer: str) -> str:
    """
    Constructs alias output

    Args:
        ch (character): Character object
        org_name (str): Name of organization
        org_dict (dict): Organization dictionary
        delta (int): Change in CC
        footer (str): Footer string

    Return:
        str: Output string
    """

    # Set default values for thumbnail and color
    img_url = org_dict.pop("imgurl", default="https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Organization-Reputation-Manager-Redux/refs/heads/main/Data/image.png")
    color = org_dict.pop("color", default=color)

    # Update CC and grab prefix
    cc_value = update_cc(ch, org_name, delta, img_url, color)
    prefix = ctx.prefix

    # Create reward key list
    reward_key_list = []

    # For each key in the organization dictionary
    for key in org_dict:

        try:

            # If the cc_value is greater than the key threshold, add key to reward key list
            if cc_value >= int(key):
                reward_key_list.append(key)

        # If the key is not an integer
        except:
            pass

    # Sort to ensure that keys are in order
    reward_key_list.sort(key=int)

    # Create reward output
    reward_output = [[]]

    # Set max character length and embed page
    MAX_LENGTH = 950
    i = 0

    # For each reward key
    for key in reward_key_list:

        # If key is not 1
        if key != "1":
            org_dict[key].insert(0, f"**{key} Points:**")

        # If key is 1
        else:
            org_dict[key].insert(0, f"**{key} Point:**")

        # If length of output is less than or equal to max character length, add to embed page
        if len("\n".join(reward_output[i] + org_dict[key])) <= MAX_LENGTH:
            reward_output[i] += org_dict[key] + ["\n"]

        # Increment page and add to embed page
        else:
            i += 1
            reward_output.append(org_dict[key] + ["\n"])

    # Insert header
    reward_output[0].insert(0, "***Current Redemption/Reward List:***")

    # If there are no rewards to display
    if len(reward_output[0]) == 1:
        reward_output[0].append("None")

    # If change was positive
    if delta > 0:
        verb_str = f"Added {delta} to"

    # If change was negative
    elif delta < 0:
        verb_str = f"Removed {abs(delta)} From"

    # Checking reputation
    else:
        verb_str = "Is Checking"

    # Insert header
    reward_output[0].insert(0, f"**Current Reputation:** {cc_value}\n")

    # If there is only one embed page
    if len(reward_output) == 1:
        f = "\n".join(reward_output[0])

        return f"{prefix}embed -title '{name} {verb_str} Their Reputation With {org_name}' -f '{f}' -color '{color}' -thumb '{img_url}' -footer '{footer}'"

    # If there is more than one embed page
    else:
        f_output = []

        # For each embed page
        for output in reward_output:

            # Join body content
            f = "\n".join(output)

            # If first embed page
            if output == reward_output[0]:
                f_output.append(f"{prefix}embed -color '{color}' -title '{name} {verb_str} Their Reputation With {org_name}' -f '{f}' -color '{color}' -thumb '{img_url}'")

            # If last embed page
            elif output == reward_output[-1]:
                f_output.append(f"{prefix}embed -f '{f}' -color '{color}' -footer '{footer}'")

            # If not first or last embed page
            else:
                f_output.append(f"{prefix}embed -f '{f}' -color '{color}'")

        return "\n".join(f_output)


def main(input_list: list[str]) -> str:
    """
    Main program function
    
    Args:
        input_list (list[str]): List of inputs

    Return:
        str: Embed string
    """

    # Setup prefix and footer
    prefix = ctx.prefix
    footer = f"{prefix}rep <organization name> <#> | 9/21/26 | ShadowsStride"

    # Try to load character object
    try:
        ch = character()

    # If character is not selected
    except:
        return f"{prefix}embed -title 'You Have Been Sneak Attacked by an Error' -f 'You must have a character selected' -color '#CF142B' -thumb 'https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Organization-Reputation-Manager-Redux/refs/heads/main/Data/image.png' -footer '{footer}'"

    # If SVAR exists, load dictionary
    if (svar_dict := get_svar("org_rep_settings")):
        svar_dict = load_json(svar_dict)

    # If SVAR does not exist, throw error
    else:
        return f"{prefix}embed -title 'You Have Been Sneak Attacked by an Error' -f '`org_rep_settings` SVAR has not been setup' -color '#CF142B' -thumb 'https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Organization-Reputation-Manager-Redux/refs/heads/main/Data/image.png' -footer '{footer}'"

    # If there isn't at least one input
    if len(input_list) < 1:
        
        # Output list creation
        output_list = []

        # For each organization in SVAR dict
        for org in svar_dict:

            # If reputation counter exists
            if ch.cc_exists(f"Rep - {org}"):

                # If the counter is not 0, add organization with rep value to output list
                if (cc_value := ch.cc(f"Rep - {org}").value) != 0:
                    output_list.append(f"**{org}:** {cc_value}")

        # If output list is empty
        if len(output_list) == 0:
            output_list.append("None")

        f = "\n".join(output_list)

        return f"{prefix}embed -title '{name}'s Reputation' -f '{f}' -color '{color}' -thumb 'https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Organization-Reputation-Manager-Redux/refs/heads/main/Data/image.png' -footer '{footer}'"

    # If it finds at least one match (searching for organization names)
    if (search_result := search_list(input_list[0], svar_dict.keys())):

        # If it find exactly one match
        if len(search_result) == 1:
            input_list[0] = search_result[0]

        # If it finds more than one match
        else:

            # If there is an exact match
            if (search_result2 := multiple_match_determine(search_result, input_list[0])):
                input_list[0] = search_result2

            # If there is not an exact match
            else:
                search_result.insert(0, "**Multiple Matches Found:**")
                f = "\n".join(search_result)

                return f"{prefix}embed -title 'You Have Been Sneak Attacked by an Error' -f '{f}' -color '#CF142B' -thumb 'https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Organization-Reputation-Manager-Redux/refs/heads/main/Data/image.png' -footer '{footer}'"

    # If no matches were found
    else:
        return f"{prefix}embed -title 'You Have Been Sneak Attacked by an Error' -f 'Organization not found (`{input_list[0]}`)' -color '#CF142B' -thumb 'https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Organization-Reputation-Manager-Redux/refs/heads/main/Data/image.png' -footer '{footer}'"

    # If there are at least 2 inputs
    if len(input_list) > 1:

        # Try to convert second input into a number
        try:
            input_list[1] = int(input_list[1])

        # If second input is not a number
        except:
            input_list[1] = 0

    # If there aren't at least 2 inputs
    else:
        input_list.append(0)
    
    return get_rewards(ch, input_list[0], svar_dict[input_list[0]], input_list[1], footer)


# Main program function
output = main(&ARGS&)


